flowchart TD
    S1["Student opens the site"] --> S2{"Role screen:<br/>Student or Driver?"}
    S2 -->|"Student"| S3["Reservation UI shown"]
    S3 --> S4["Tap Reserve Seat"]
    S4 --> W1[("WRITE<br/>transaction on<br/>coasterReservations")]
    S3 --> S5["Scan seat QR to check in"]
    S5 --> W2[("WRITE<br/>transaction on<br/>that one reservation")]
    S3 --> S6["Tap Cancel Reservation"]
    S6 --> W2b[("WRITE<br/>transaction removes<br/>the reservation")]

    D1["Driver opens the site"] --> S2
    S2 -->|"Driver"| D2["Email + password form"]
    D2 -->|"Correct login"| D3["Driver Panel shown"]
    D2 -->|"Wrong login"| D2err["Inline error shown"] --> D2
    D3 --> D4["Tap Available / Not Available"]
    D3 --> D5["Tap Full / Not Full"]
    D4 --> W3[("WRITE<br/>update on<br/>coasterAvailability")]
    D5 --> W3

    W1 --> DB1[("Firebase Realtime Database<br/>coasterReservations")]
    W2 --> DB1
    W2b --> DB1
    W3 --> DB2[("Firebase Realtime Database<br/>coasterAvailability")]

    DB1 -->|"onValue push"| R1["Every open browser tab<br/>(students + driver)"]
    DB2 -->|"onValue push"| R1

    R1 --> U1["Seat grid + 'X of 30 open' counter redraw"]
    R1 --> U2["Availability / Full banner redraw"]
    R1 --> U3["Reserve button enabled or disabled"]
    R1 --> U4["Driver Panel status line redraw"]
